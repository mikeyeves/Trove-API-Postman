{
  "info": {
    "_postman_id": "dfc329c8-5ea2-459b-b457-21148f57df20",
    "name": "Trove API v3 (National Library of Australia)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Trove API v3 — search and retrieve Australian newspapers (1803–1950s+, OCR full text), government gazettes, magazines, books, images, maps, diaries, people/organisations and lists from the National Library of Australia and partners. A free API key is required (Trove account → Profile → API keys) and is sent as the key query parameter. Quota: 200 calls/minute.\n\nDocs: https://trove.nla.gov.au/about/create-something/using-api/v3/api-technical-guide · Interactive console: https://api.trove.nla.gov.au/"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "key"
      },
      {
        "key": "value",
        "value": "{{trove_key}}"
      },
      {
        "key": "in",
        "value": "query"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.response.code===401||pm.response.code===403) console.warn('Trove: set your API key in the collection variable trove_key.');",
          "if(pm.response.code===429) console.warn('Trove quota: 200 calls/minute.');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "★ Search",
      "id": "63bc49a1-d8f7-410c-a2e1-c25c76c9e1f1",
      "item": [
        {
          "name": "Search (all parameters)",
          "id": "8f255149-e01e-4e4c-9e66-65f5bb0a3623",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{trove_api}}/result?category=newspaper&q={{query}}&encoding=json&n=20",
              "host": [
                "{{trove_api}}"
              ],
              "path": [
                "result"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "newspaper",
                  "disabled": false,
                  "description": "all | newspaper | magazine | image | research | book | diary | music | people | list (repeatable). Required."
                },
                {
                  "key": "q",
                  "value": "{{query}}",
                  "disabled": false,
                  "description": "Search query; supports indexes (fulltext:, title:, creator:, date:[1900 TO 1910], etc.)"
                },
                {
                  "key": "encoding",
                  "value": "json",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "n",
                  "value": "20",
                  "disabled": false,
                  "description": "results per category, max 100"
                },
                {
                  "key": "s",
                  "value": "*",
                  "disabled": true,
                  "description": "cursor: * then nextStart from previous response (URL-encode)"
                },
                {
                  "key": "sortby",
                  "value": "",
                  "disabled": true,
                  "description": "relevance | datedesc | dateasc"
                },
                {
                  "key": "reclevel",
                  "value": "brief",
                  "disabled": true,
                  "description": "brief | full"
                },
                {
                  "key": "include",
                  "value": "",
                  "disabled": true,
                  "description": "tags, comments, lists, holdings, links, subscribinglibs, workversions, articletext (comma-separated)"
                },
                {
                  "key": "facet",
                  "value": "",
                  "disabled": true,
                  "description": "e.g. decade, year, state, title, category, illustrated, format, language"
                },
                {
                  "key": "l-decade",
                  "value": "",
                  "disabled": true,
                  "description": "e.g. 190 = 1900–1909"
                },
                {
                  "key": "l-year",
                  "value": "",
                  "disabled": true,
                  "description": "e.g. 1905 (needs l-decade for newspapers)"
                },
                {
                  "key": "l-state",
                  "value": "",
                  "disabled": true,
                  "description": "newspaper state, e.g. New South Wales, Victoria, Queensland, Western Australia"
                },
                {
                  "key": "l-title",
                  "value": "",
                  "disabled": true,
                  "description": "newspaper title id"
                },
                {
                  "key": "l-category",
                  "value": "",
                  "disabled": true,
                  "description": "newspaper article category, e.g. Article, Advertising, Family Notices"
                },
                {
                  "key": "l-illustrated",
                  "value": "",
                  "disabled": true,
                  "description": "true/false"
                },
                {
                  "key": "l-format",
                  "value": "",
                  "disabled": true,
                  "description": "non-newspaper format, e.g. Book, Photograph, Map"
                },
                {
                  "key": "bulkHarvest",
                  "value": "",
                  "disabled": true,
                  "description": "true = stable identifier sort for harvesting"
                }
              ]
            },
            "description": "Search one or more Trove categories.\n\nDocs: https://trove.nla.gov.au/about/create-something/using-api/v3/api-technical-guide"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j={};try{j=pm.response.json();}catch(e){}",
                  "const cats=j.category||[];const rows=[];let total=0;",
                  "cats.forEach(c=>{const r=c.records||{};total+=Number(r.total||0);(r.article||[]).forEach(a=>rows.push([c.code,`<a href=\"${a.troveUrl||''}\">${(a.heading||'').slice(0,120)}</a>`,a.date||'',(a.title&&a.title.title)||'',a.page||'',(a.snippet||'').replace(/<[^>]+>/g,'').slice(0,160)]));(r.work||[]).forEach(w=>rows.push([c.code,`<a href=\"${w.troveUrl||''}\">${(w.title||'').slice(0,120)}</a>`,w.issued||'',[].concat(w.contributor||[]).join('; ').slice(0,80),'',(w.type||[]).join?w.type.join(', '):'']));(r.people||[]).forEach(p=>rows.push([c.code,`<a href=\"${p.troveUrl||''}\">${p.primaryName||''}</a>`,'','','',(p.occupation||[]).join?p.occupation.join(', '):'']));});",
                  "const next=(cats[0]&&cats[0].records&&cats[0].records.nextStart)||'';",
                  "pm.visualizer.set(`<style>table{border-collapse:collapse;font:13px sans-serif}td,th{border:1px solid #ccc;padding:4px 8px;vertical-align:top}th{background:#eee}</style><p>{{total}} total{{#if next}} · next page: s={{next}}{{/if}}</p><table><tr><th>Cat</th><th>Heading / title</th><th>Date</th><th>Newspaper / creator</th><th>Page</th><th>Snippet / type</th></tr>{{#each rows}}<tr>{{#each this}}<td>{{{this}}}</td>{{/each}}</tr>{{/each}}</table>`,{rows,total,next});"
                ]
              }
            }
          ]
        },
